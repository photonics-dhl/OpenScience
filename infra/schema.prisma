generator client {
  provider      = "prisma-client-js"
  // P1A-9：生产 api 容器 node:22-alpine（musl）需 linux-musl engine；本地/云上集成走 native
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMeta {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_meta")
}

enum UserStatus {
  invited
  email_verified
  identity_verified
  suspended
  deleted
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.Citext
  passwordHash       String              @map("password_hash")
  displayName        String              @map("display_name")
  status             UserStatus          @default(invited)
  platformRole       PlatformRole        @default(user) @map("platform_role")
  /// 配额 user_level 档位（free/pro/team，P1E-5 迁移 21；resolvePolicy 的 userLevel 来源）
  level              String              @default("free")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  emailVerifications EmailVerification[]
  usedInvitations    Invitation[]        @relation("InvitationUsedBy")

  ownedWorkspaces          Workspace[]              @relation("WorkspaceOwner")
  memberships              Membership[]
  sentWorkspaceInvitations WorkspaceInvitation[]    @relation("WorkspaceInvitationInviter")
  createdResearchObjects   ResearchObject[]         @relation("ResearchObjectCreator")
  ingestionBatches         IngestionBatch[]
  uploadedArtifacts        Artifact[]               @relation("ArtifactUploader")
  authoredCommits          Commit[]
  grantedVisibilityGrants  VisibilityGrant[]        @relation("VisibilityGranter")
  receivedVisibilityGrants VisibilityGrant[]        @relation("VisibilityGrantee")
  visibilityRequests       VisibilityRequest[]      @relation("VisibilityRequester")
  authoredIssues           Issue[]                  @relation("IssueAuthor")
  authoredPullRequests     PullRequest[]            @relation("PRAuthor")
  authoredComments         Comment[]                @relation("CommentAuthor")
  authoredReviews          Review[]                 @relation("Reviewer")
  authorEntries            Author[]                 @relation("AuthorEntry")
  contributions            Contribution[]           @relation("ContributionUser")
  notifications            Notification[]
  sandboxJobs              SandboxJob[]
  agentSessions            AgentSession[]
  agentApprovals           ToolApproval[]           @relation("ToolApprover")
  appealsFiled             Appeal[]                 @relation("Appellant")
  appealsModerated         Appeal[]                 @relation("Moderator")
  selectedEditorialEntries EditorialSelection[]     @relation("EditorialSelector")
  researchIdentityProfile  ResearchIdentityProfile?
  verifiedEvidenceRecords  EvidenceRecord[]         @relation("EvidenceVerifier")

  @@map("users")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  email      String?   @db.Citext
  createdBy  String    @map("created_by")
  usedBy     String?   @map("used_by") @db.Uuid
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  usedByUser User?     @relation("InvitationUsedBy", fields: [usedBy], references: [id], onDelete: SetNull)

  @@map("invitations")
}

model EmailVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  expiresAt   DateTime  @map("expires_at")
  lastSentAt  DateTime  @map("last_sent_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model SignupChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.Citext
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  expiresAt   DateTime  @map("expires_at")
  lastSentAt  DateTime  @map("last_sent_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  // Partial unique index for one active challenge/email is defined in migration SQL.
  @@map("signup_challenges")
}

model MailOutbox {
  id        String   @id @default(uuid()) @db.Uuid
  toEmail   String   @map("to_email") @db.Citext
  subject   String
  bodyText  String   @map("body_text")
  sentVia   String   @default("outbox") @map("sent_via")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mail_outbox")
}

enum WorkspaceType {
  personal
  team
}

enum WorkspaceStatus {
  active
  archived
}

enum PlatformRole {
  user
  moderator
  platform_admin
}

enum WorkspaceRole {
  owner
  maintainer
  author
  contributor
  reviewer
  viewer
}

enum WorkspaceInvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model Workspace {
  id              String                @id @default(uuid()) @db.Uuid
  type            WorkspaceType
  name            String
  ownerId         String                @map("owner_id") @db.Uuid
  status          WorkspaceStatus       @default(active)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  owner           User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members         Membership[]
  invitations     WorkspaceInvitation[]
  researchObjects ResearchObject[]
  artifacts       Artifact[]
  evidenceRecords EvidenceRecord[]
  sandboxJobs     SandboxJob[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model WorkspaceInvitation {
  id            String                    @id @default(uuid()) @db.Uuid
  workspaceId   String                    @map("workspace_id") @db.Uuid
  email         String                    @db.Citext
  role          WorkspaceRole
  status        WorkspaceInvitationStatus @default(pending)
  invitedBy     String                    @map("invited_by") @db.Uuid
  expiresAt     DateTime                  @map("expires_at")
  respondedAt   DateTime?                 @map("responded_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser User                      @relation("WorkspaceInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  workspaceId String?  @map("workspace_id") @db.Uuid
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  requestId   String?  @map("request_id")
  ip          String?

  @@index([action])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model QuotaPolicy {
  id         String   @id @default(uuid()) @db.Uuid
  scope      String
  scopeKey   String?  @map("scope_key")
  resource   String
  limitValue BigInt   @map("limit_value")
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeKey, resource])
  @@index([resource])
  @@map("quota_policies")
}

model UsageLedger {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  resource       String
  delta          BigInt
  kind           String
  period         String?
  reason         String?
  idempotencyKey String?  @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, resource, createdAt])
  @@index([workspaceId, resource, createdAt])
  @@index([resource, period])
  @@map("usage_ledger")
}

// --- P1E-4/5：Python 沙箱作业（§10.3/§15；DDL 事实源 = 迁移 20/21，本模型为补齐登记，勿 migrate dev/db push）---
// 注：迁移 20 的复合外键 (user_id, workspace_id) → memberships 仅 DB 侧强制，此处不建 prisma relation
//（memberships 复合唯一键顺序为 (workspaceId, userId)，与 FK 列序相反，避免漂移不建模）。

enum SandboxJobStatus {
  pending
  running
  completed
  failed
  timeout
  cancelled
}

model SandboxJob {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  script         String
  status         SandboxJobStatus @default(pending)
  result         Json?
  context        Json?
  runtimeSeconds Int?             @map("runtime_seconds")
  createdAt      DateTime         @default(now()) @map("created_at")
  completedAt    DateTime?        @map("completed_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts SandboxArtifact[]

  @@index([workspaceId], map: "idx_sandbox_jobs_workspace")
  @@index([userId], map: "idx_sandbox_jobs_user")
  @@index([status], map: "idx_sandbox_jobs_status")
  @@index([createdAt], map: "idx_sandbox_jobs_created")
  @@map("sandbox_jobs")
}

model SandboxArtifact {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  filename  String
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  job SandboxJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "idx_sandbox_artifacts_job")
  @@map("sandbox_artifacts")
}

// --- P1B-2：Research Object / SDF 数据实体（§15、§4.1、§4.2、§5.1）---

enum RoStatus {
  draft
  under_review
  approved
  published
  revised
  withdrawn
  restricted
  rejected
  archived
}

enum RoVisibility {
  private
  invite_only
  public
}

enum SdfNodeType {
  problem
  insight
  method
  results
  limitations
  reproducibility
}

model ResearchObject {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  title          String
  status         RoStatus     @default(draft)
  visibility     RoVisibility @default(private)
  version        Int          @default(1) // 乐观锁（§16）；P1B-4 版本引擎推进
  publicId       String?      @unique @map("public_id") // 公开 RO ID（§6.1），发布时分配（P1B-7），draft 无
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  idempotencyKey String?      @unique @map("idempotency_key")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator             User                 @relation("ResearchObjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  sdfDocument         SdfDocument?
  branches            Branch[]
  commits             Commit[]             @relation("CommitResearchObject")
  versions            Version[]            @relation("VersionResearchObject")
  identifiers         Identifier[]
  visibilityGrants    VisibilityGrant[]
  visibilityRequests  VisibilityRequest[]
  forkResults         ForkRelation[]       @relation("ForkResult")
  forkSources         ForkRelation[]       @relation("ForkSource")
  issues              Issue[]
  pullRequests        PullRequest[]
  authors             Author[]
  contributions       Contribution[]
  licenseAssignments  LicenseAssignment[]
  agentSessions       AgentSession[]
  aiReviews           AiReview[]
  appeals             Appeal[]
  ingestionBatches    IngestionBatch[]
  editorialSelections EditorialSelection[]
  claimNodes          ClaimNode[]
  evidenceRecords     EvidenceRecord[]
  presentationAssets  PresentationAsset[]

  @@unique([id, workspaceId], map: "research_objects_id_workspace_id_key")
  @@index([workspaceId])
  @@map("research_objects")
}

model SdfDocument {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  coreJson         Json     @map("core_json") // SdfCore 结构（P1B-1 validateSdfCore 校验）
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  nodes          SdfNode[]

  @@unique([researchObjectId])
  @@map("sdf_documents")
}

model SdfNode {
  id            String      @id @default(uuid()) @db.Uuid
  sdfDocumentId String      @map("sdf_document_id") @db.Uuid
  nodeType      SdfNodeType @map("node_type")
  content       String      @default("")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  sdfDocument SdfDocument @relation(fields: [sdfDocumentId], references: [id], onDelete: Cascade)

  @@unique([sdfDocumentId, nodeType])
  @@index([sdfDocumentId])
  @@map("sdf_nodes")
}

// --- P1B-3：Blob 内容寻址存储 + Artifact 元数据（§7.2.1 内容寻址 + §7.2.2 元数据 + §13.1 数据库只存元数据/对象键）---

model Blob {
  sha256     String   @id @db.Char(64) // SHA-256 hex，内容寻址主键（去重，§7.1）
  storageKey String   @map("storage_key") // 对象存储路径（`blobs/<h2>/<h4>/<sha256>` 分段）
  size       BigInt // 字节数
  createdAt  DateTime @default(now()) @map("created_at")

  artifacts Artifact[]

  @@map("blobs")
}

model Artifact {
  id             String   @id @default(uuid()) @db.Uuid
  logicalPath    String   @map("logical_path") // 用户视角路径（非唯一，P1B-4 Version Manifest 再去重）
  mimeType       String?  @map("mime_type") // MIME 检测结果（失败 = null，允许上传）
  size           BigInt // 字节数（冗余，免 join Blob）
  blobSha256     String   @map("blob_sha256") @db.Char(64) // 指向 Blob（内容寻址）
  uploadedBy     String   @map("uploaded_by") @db.Uuid // 上传者（审计，§17）
  workspaceId    String   @map("workspace_id") @db.Uuid // 所属 Workspace（越权防护，§17）
  createdAt      DateTime @default(now()) @map("created_at")
  idempotencyKey String?  @unique @map("idempotency_key")

  blob            Blob             @relation(fields: [blobSha256], references: [sha256], onDelete: Restrict)
  uploader        User             @relation("ArtifactUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ingestionTasks  IngestionTask[]
  evidenceRecords EvidenceRecord[]

  @@unique([id, workspaceId], map: "artifacts_id_workspace_id_key")
  @@index([workspaceId])
  @@index([blobSha256])
  @@map("artifacts")
}

// --- P1B-4：Commit/Manifest 增量版本引擎（§15 Branch/Commit/ChangeSet/Version/VersionManifest + §7.2.3 Manifest 引用 + §7.2.4 复用 Blob + §7.2.5 JSON Patch）---

model Branch {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  name             String // 默认 "main"；Phase 1C 分支扩展
  isDefault        Boolean  @default(false) @map("is_default")
  // P1C-2：分支起点 Commit（可选，§21.2 步骤 11 Fork 后建分支锚点）。新分支首个 commit 的 parent = 锚点。
  headCommitId     String?  @map("head_commit_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  commits        Commit[]
  sourcePrs      PullRequest[]  @relation("PRSourceBranch")
  targetPrs      PullRequest[]  @relation("PRTargetBranch")

  @@unique([researchObjectId, name])
  @@index([researchObjectId])
  @@index([headCommitId])
  @@map("branches")
}

model Commit {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  parentCommitId   String?  @map("parent_commit_id") @db.Uuid // 前驱 Commit（链）
  message          String // 提交说明（§8 Commit 语义）
  authorId         String   @map("author_id") @db.Uuid
  idempotencyKey   String?  @unique @map("idempotency_key") // §16 幂等键
  createdAt        DateTime @default(now()) @map("created_at")

  researchObject ResearchObject @relation("CommitResearchObject", fields: [researchObjectId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parentCommit   Commit?        @relation("CommitParent", fields: [parentCommitId], references: [id], onDelete: Restrict)
  childCommits   Commit[]       @relation("CommitParent")
  author         User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  changesets     ChangeSet[]
  versions       Version[]

  @@index([branchId, createdAt])
  @@index([researchObjectId])
  @@map("commits")
}

model ChangeSet {
  id        String   @id @default(uuid()) @db.Uuid
  commitId  String   @map("commit_id") @db.Uuid
  kind      String // 'sdf_core' | 'artifact_add' | 'artifact_update' | 'artifact_remove'
  payload   Json // 单 op RFC 6902（sdf_core）或 artifact 变化
  createdAt DateTime @default(now()) @map("created_at")

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId])
  @@map("changesets")
}

enum VersionStatus {
  draft
  under_review
  approved
  published
  revised
  withdrawn
  rejected
  restricted
}

model Version {
  id               String        @id @default(uuid()) @db.Uuid
  researchObjectId String        @map("research_object_id") @db.Uuid
  commitId         String        @map("commit_id") @db.Uuid
  versionNo        Int           @map("version_no") // RO 内递增版本号（外部可读，§2.2 原则 5）
  publicVersionId  String?       @unique @map("public_version_id") // OSR-YYYY-NNNNNN-vN（§6.1），发布时分配
  status           VersionStatus @default(draft) // P1B-7 发布状态机
  // P1D-8：父版本（v2→v1，§2.2-3 增量版本链）
  parentVersionId  String?       @map("parent_version_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  researchObject      ResearchObject       @relation("VersionResearchObject", fields: [researchObjectId], references: [id], onDelete: Cascade)
  commit              Commit               @relation(fields: [commitId], references: [id], onDelete: Restrict)
  manifest            VersionManifest?
  publications        Publication[]
  forkSources         ForkRelation[]
  licenseAssignments  LicenseAssignment[]
  aiReview            AiReview?
  appeals             Appeal[]
  parentVersion       Version?             @relation("VersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions       Version[]            @relation("VersionParent")
  editorialSelections EditorialSelection[]
  claimNodes          ClaimNode[]
  evidenceRecords     EvidenceRecord[]
  presentationAssets  PresentationAsset[]

  @@unique([researchObjectId, versionNo])
  @@unique([id, researchObjectId], map: "versions_id_research_object_id_key")
  @@index([researchObjectId])
  @@map("versions")
}

model VersionManifest {
  id        String   @id @default(uuid()) @db.Uuid
  versionId String   @unique @map("version_id") @db.Uuid
  coreJson  Json     @map("core_json") // 版本 SDF core 快照（§7.2.3）
  createdAt DateTime @default(now()) @map("created_at")

  version Version         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  entries ManifestEntry[]

  @@map("version_manifests")
}

model ManifestEntry {
  id          String @id @default(uuid()) @db.Uuid
  manifestId  String @map("manifest_id") @db.Uuid
  logicalPath String @map("logical_path") // Artifact 逻辑路径
  artifactId  String @map("artifact_id") @db.Uuid // 指向 Artifact（引用）
  blobSha256  String @map("blob_sha256") @db.Char(64) // 冗余：重建免 join Blob（§7.2.3）

  manifest VersionManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([manifestId, logicalPath])
  @@index([manifestId])
  @@map("manifest_entries")
}

// --- P1B-6：标识层与时间戳服务（§6.1 公开 ID + §6.2 时间戳/哈希 + §15 Identifier/Publication）---

model Identifier {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  publicId         String   @unique @map("public_id") // OSR-YYYY-NNNNNN（§6.1）
  issuedAt         DateTime @map("issued_at")
  legalDisclaimer  String?  @map("legal_disclaimer") // §6.2 免责声明文案预留（Phase 1D 展示）

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)

  @@map("identifiers")
}

model Publication {
  id              String   @id @default(uuid()) @db.Uuid
  versionId       String   @map("version_id") @db.Uuid
  publicVersionId String   @unique @map("public_version_id") // OSR-YYYY-NNNNNN-vN（§6.1）
  contentSha256   String   @map("content_sha256") // 版本内容哈希（§6.2，Manifest 排序聚合）
  publishedAt     DateTime @map("published_at") // UTC 事务时间
  legalDisclaimer String?  @map("legal_disclaimer") // §6.2 免责声明预留

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("publications")
}

// --- Optical Editorial v3 Task 11：期刊策展层（不改变 RO/Version 事实身份）---

enum EditorialSelectionState {
  draft
  internal_review
  scheduled
  published
}

model EditorialCollection {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  selections EditorialSelection[]

  @@map("editorial_collections")
}

model EditorialSelection {
  id                String                  @id @default(uuid()) @db.Uuid
  collectionId      String                  @map("collection_id") @db.Uuid
  researchObjectId  String                  @map("research_object_id") @db.Uuid
  versionId         String                  @map("version_id") @db.Uuid
  selectedBy        String                  @map("selected_by") @db.Uuid
  titleSnapshot     String                  @map("title_snapshot")
  publicIdSnapshot  String                  @map("public_id_snapshot")
  versionNoSnapshot Int                     @map("version_no_snapshot")
  sdfSnapshot       Json                    @map("sdf_snapshot")
  note              String                  @default("")
  media             Json                    @default("[]")
  disclosure        String
  sortOrder         Int                     @default(0) @map("sort_order")
  state             EditorialSelectionState @default(draft)
  scheduledAt       DateTime?               @map("scheduled_at")
  publishedAt       DateTime?               @map("published_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  collection     EditorialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  researchObject ResearchObject      @relation(fields: [researchObjectId], references: [id], onDelete: Restrict)
  version        Version             @relation(fields: [versionId], references: [id], onDelete: Restrict)
  selector       User                @relation("EditorialSelector", fields: [selectedBy], references: [id], onDelete: Restrict)

  @@unique([collectionId, researchObjectId, versionId])
  @@index([collectionId, state, sortOrder])
  @@index([researchObjectId])
  @@index([versionId])
  @@map("editorial_selections")
}

// --- P1B-7：RO 可见性模型（§4.2 三态 + §4.2 扩大显式审批记录 + §17 越权防护）---

model VisibilityGrant {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  granteeId        String   @map("grantee_id") @db.Uuid // 被指定账户（invite_only 可见）
  grantedBy        String   @map("granted_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  grantee        User           @relation("VisibilityGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granter        User           @relation("VisibilityGranter", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@unique([researchObjectId, granteeId])
  @@index([researchObjectId])
  @@map("visibility_grants")
}

model VisibilityRequest {
  id               String       @id @default(uuid()) @db.Uuid
  researchObjectId String       @map("research_object_id") @db.Uuid
  requestedBy      String       @map("requested_by") @db.Uuid
  fromVisibility   RoVisibility @map("from_visibility")
  toVisibility     RoVisibility @map("to_visibility")
  status           String       @default("pending") // pending → approved/rejected（Phase 1D 审批流）
  createdAt        DateTime     @default(now()) @map("created_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  requester      User           @relation("VisibilityRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([researchObjectId])
  @@map("visibility_requests")
}

// --- P1C-1：协作域数据模型（§15 实体 + §8.2 PR 声明 + §3.4 CRediT + §6.3 三类许可）---

enum IssueKind {
  question
  method_repro
  failure
  bug_report
  suggestion
}

enum ReviewVerdict {
  approve
  request_changes
  comment
}

enum CreditRole {
  conceptualization
  methodology
  software
  validation
  data_curation
  visualization
  writing
  supervision
  investigation
  resources
  project_administration
  funding_acquisition
}

model ForkRelation {
  id                String   @id @default(uuid()) @db.Uuid
  forkedRoId        String   @map("forked_ro_id") @db.Uuid
  sourceRoId        String   @map("source_ro_id") @db.Uuid
  sourceVersionId   String   @map("source_version_id") @db.Uuid
  sourceContentHash String   @map("source_content_hash") // §8.1 内容哈希
  createdAt         DateTime @default(now()) @map("created_at")

  forkedRo      ResearchObject @relation("ForkResult", fields: [forkedRoId], references: [id], onDelete: Restrict)
  sourceRo      ResearchObject @relation("ForkSource", fields: [sourceRoId], references: [id], onDelete: Restrict)
  sourceVersion Version        @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)

  @@unique([forkedRoId]) // 一 RO 至多一个来源（§8.1 不可移除）
  @@index([sourceRoId])
  @@map("fork_relations")
}

model Issue {
  id               String    @id @default(uuid()) @db.Uuid
  researchObjectId String    @map("research_object_id") @db.Uuid
  title            String
  body             String    @default("")
  kind             IssueKind @default(question) // §8 五类语义
  status           String    @default("open") // open/closed
  authorId         String    @map("author_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  author         User           @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  comments       Comment[]

  @@index([researchObjectId])
  @@map("issues")
}

model PullRequest {
  id                 String   @id @default(uuid()) @db.Uuid
  researchObjectId   String   @map("research_object_id") @db.Uuid
  sourceBranchId     String   @map("source_branch_id") @db.Uuid
  targetBranchId     String   @map("target_branch_id") @db.Uuid
  title              String
  body               String   @default("")
  // §8.2 声明字段
  changedSdfFields   Json     @map("changed_sdf_fields")
  changedFiles       Json     @map("changed_files")
  changesMethod      Boolean  @map("changes_method")
  changesData        Boolean  @map("changes_data")
  changesConclusion  Boolean  @map("changes_conclusion")
  newContributors    Json     @map("new_contributors") // [{ userId, creditRole[] }]
  dataLicense        String   @map("data_license")
  codeLicense        String   @map("code_license")
  conflictOfInterest String   @map("conflict_of_interest")
  autoChecks         Json     @default("{}") @map("auto_checks") // 结构化占位（真实检查 P1D）
  requestsRelease    Boolean  @map("requests_release")
  status             String   @default("open") // open/merged/rejected
  authorId           String   @map("author_id") @db.Uuid
  // P1C-6：幂等键（§16 防重复提交）；重发同 key → 返回既有 PR。
  idempotencyKey     String?  @unique @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  sourceBranch   Branch         @relation("PRSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  targetBranch   Branch         @relation("PRTargetBranch", fields: [targetBranchId], references: [id], onDelete: Restrict)
  author         User           @relation("PRAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviews        Review[]
  comments       Comment[]

  @@index([researchObjectId])
  @@index([sourceBranchId])
  @@map("pull_requests")
}

model Review {
  id         String        @id @default(uuid()) @db.Uuid
  prId       String        @map("pr_id") @db.Uuid
  reviewerId String        @map("reviewer_id") @db.Uuid
  verdict    ReviewVerdict
  body       String        @default("")
  items      Json          @default("[]") // 逐项意见 [{ path, kind, comment }]
  createdAt  DateTime      @default(now()) @map("created_at")

  pr       PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  reviewer User        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  Comment  Comment[]

  @@index([prId])
  @@map("reviews")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  issueId   String?  @map("issue_id") @db.Uuid // 多态：Issue/PR/Review（§15 一处实现）
  prId      String?  @map("pr_id") @db.Uuid
  reviewId  String?  @map("review_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  issue  Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pr     PullRequest? @relation(fields: [prId], references: [id], onDelete: Cascade)
  review Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([prId])
  @@index([reviewId])
  @@map("comments")
}

model Author {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  sortOrder        Int      @map("sort_order") // 作者顺序（作者组确认，§3.4）
  isCorresponding  Boolean  @default(false) @map("is_corresponding")
  affiliation      String? // P1D-9：机构声明（§4.3 公开页必显）
  createdAt        DateTime @default(now()) @map("created_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  user           User           @relation("AuthorEntry", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([researchObjectId, userId])
  @@index([researchObjectId])
  @@map("authors")
}

model Contribution {
  id               String     @id @default(uuid()) @db.Uuid
  researchObjectId String     @map("research_object_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  creditRole       CreditRole @map("credit_role")
  createdAt        DateTime   @default(now()) @map("created_at") // 按时间追加（§3.4 不可抹除）

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Restrict)
  user           User           @relation("ContributionUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([researchObjectId])
  @@map("contributions")
}

model LicenseAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  versionId        String?  @map("version_id") @db.Uuid // null = RO 级，非空 = 版本级（§6.3）
  licenseType      String   @map("license_type") // text/code/data
  licenseId        String   @map("license_id") // CC-BY-4.0/MIT/CC0（§24 配置位，标准标识）
  createdAt        DateTime @default(now()) @map("created_at")

  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  version        Version?       @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([researchObjectId, versionId, licenseType])
  @@index([researchObjectId])
  @@map("license_assignments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String // pull_request.opened / merged / review.requested / issue.updated
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// --- P1D-2：Hermes 会话与异步任务（§15 AgentSession/AgentTask/ToolApproval + §9.3 长任务异步）---

model AgentSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  researchObjectId String?  @map("research_object_id") @db.Uuid
  kind             String
  title            String   @default("")
  status           String   @default("active")
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchObject ResearchObject? @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  tasks          AgentTask[]
  ingestionBatch IngestionBatch?

  @@index([userId])
  @@map("agent_sessions")
}

model AgentTask {
  id               String          @id @default(uuid()) @db.Uuid
  sessionId        String          @map("session_id") @db.Uuid
  kind             String
  status           AgentTaskStatus @default(pending)
  progress         Int             @default(0)
  payload          Json            @default("{}")
  interestContext  Json?           @map("interest_context")
  result           Json?
  error            String?
  retryCount       Int             @default(0) @map("retry_count")
  executionAttempt Int             @default(0) @map("execution_attempt")
  dispatchedAt     DateTime?       @map("dispatched_at")
  // §16 幂等键：同 key 重发 → 返回既有任务（不重复执行）
  idempotencyKey   String?         @unique @map("idempotency_key")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  session       AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvals     ToolApproval[]
  ingestionTask IngestionTask?

  @@index([sessionId])
  @@map("agent_tasks")
}

model ToolApproval {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  level      String // R0-R4（§9.4，P1D-4 审批分级）
  scope      String   @default("")
  status     String   @default("pending") // pending/approved/rejected
  prompt     Json     @default("{}")
  approvedBy String?  @map("approved_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  task     AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approver User?     @relation("ToolApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("tool_approvals")
}

enum AgentTaskStatus {
  pending
  running
  succeeded
  failed
}

enum IngestionTaskState {
  queued
  uploading
  stored
  parsing
  needs_review
  confirmed
  written
  failed_retryable
  failed_blocked
}

model IngestionBatch {
  id               String   @id @default(uuid()) @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  agentSessionId   String?  @unique @map("agent_session_id") @db.Uuid
  idempotencyKey   String?  @unique @map("idempotency_key")
  requestDigest    String   @map("request_digest") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  researchObject ResearchObject  @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  agentSession   AgentSession?   @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  tasks          IngestionTask[]

  @@index([researchObjectId])
  @@map("ingestion_batches")
}

model IngestionTask {
  id          String             @id @default(uuid()) @db.Uuid
  batchId     String             @map("batch_id") @db.Uuid
  artifactId  String             @map("artifact_id") @db.Uuid
  agentTaskId String?            @unique @map("agent_task_id") @db.Uuid
  state       IngestionTaskState @default(queued)
  retryCount  Int                @default(0) @map("retry_count")
  error       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  batch     IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  artifact  Artifact       @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  agentTask AgentTask?     @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)

  @@unique([batchId, artifactId])
  @@index([batchId])
  @@map("ingestion_tasks")
}

// --- P1D-5：AI 发布审核记录（§15 AIReview + §11.1 硬阻断 + §11.3 稳定可引用）---

model AiReview {
  id               String   @id @default(uuid()) @db.Uuid
  versionId        String   @unique @map("version_id") @db.Uuid
  researchObjectId String   @map("research_object_id") @db.Uuid
  status           String // passed / blocked
  hardBlocks       Json     @default("[]") @map("hard_blocks")
  warnings         Json     @default("[]")
  verdict          String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")

  version        Version        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  appeals        Appeal[]

  @@index([researchObjectId])
  @@map("ai_reviews")
}

// --- P1D-7：审核申诉与 Moderator 队列（§11.3 + §15 Appeal + §16 appeal.created）---

model Appeal {
  id               String    @id @default(uuid()) @db.Uuid
  versionId        String    @map("version_id") @db.Uuid
  researchObjectId String    @map("research_object_id") @db.Uuid
  aiReviewId       String    @map("ai_review_id") @db.Uuid
  appellantId      String    @map("appellant_id") @db.Uuid
  reason           String
  status           String    @default("pending") // pending / resolved / rejected
  moderatorId      String?   @map("moderator_id") @db.Uuid
  resolution       Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  resolvedAt       DateTime? @map("resolved_at")

  version        Version        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  researchObject ResearchObject @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  aiReview       AiReview       @relation(fields: [aiReviewId], references: [id], onDelete: Restrict)
  appellant      User           @relation("Appellant", fields: [appellantId], references: [id], onDelete: Restrict)
  moderator      User?          @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([status])
  @@map("appeals")
}

// --- Hermes Research Intelligence Task 2：身份、Claim/Evidence 与展示资产元数据（大对象仍走对象存储）---

enum ResearchIdentity {
  reader
  author
  reviewer
  editor
  data_steward
  developer
  student
}

enum ClaimKind {
  core
  supporting
  method
  boundary
  counter
}

enum ClaimAssessment {
  supported
  partial
  disputed
  missing
}

enum EvidenceKind {
  passage
  figure
  table
  dataset
  code
  notebook
  environment
  protocol
  supplement
  external_source
}

enum ClaimRelation {
  supports
  contradicts
  qualifies
  context
}

enum ExtractionStatus {
  succeeded
  needs_review
  blocked
  failed
}

enum PresentationAssetKind {
  svg
  chart
  interactive_html
  image
  video
}

enum PresentationAssetStatus {
  draft
  approved
  rejected
}

model ResearchIdentityProfile {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  identities      ResearchIdentity[]
  primaryIdentity ResearchIdentity   @map("primary_identity")
  disciplines     String[]           @default([])
  methods         String[]           @default([])
  topics          String[]           @default([])
  languages       String[]           @default([])
  acceptedSignals String[]           @default([]) @map("accepted_signals")
  rejectedSignals String[]           @default([]) @map("rejected_signals")
  profileVersion  Int                @default(1) @map("profile_version")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("research_identity_profiles")
}

model ClaimNode {
  id               String           @id @default(uuid()) @db.Uuid
  researchObjectId String           @map("research_object_id") @db.Uuid
  versionId        String           @map("version_id") @db.Uuid
  parentClaimId    String?          @map("parent_claim_id") @db.Uuid
  kind             ClaimKind
  statement        String
  assessment       ClaimAssessment
  conditions       String[]         @default([])
  limitations      String[]         @default([])
  provenance       Json
  extractionStatus ExtractionStatus @default(needs_review) @map("extraction_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  researchObject          ResearchObject           @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  version                 Version                  @relation(fields: [versionId, researchObjectId], references: [id, researchObjectId], onDelete: Cascade, map: "claim_nodes_version_scope_fkey")
  parentClaim             ClaimNode?               @relation("ClaimParent", fields: [parentClaimId, researchObjectId, versionId], references: [id, researchObjectId, versionId], onDelete: Cascade, map: "claim_nodes_parent_scope_fkey")
  childClaims             ClaimNode[]              @relation("ClaimParent")
  evidenceRecords         EvidenceRecord[]
  presentationAssetClaims PresentationAssetClaim[]

  @@unique([id, researchObjectId, versionId], map: "claim_nodes_id_ro_version_key")
  @@index([researchObjectId, versionId, kind])
  @@index([parentClaimId])
  @@map("claim_nodes")
}

model EvidenceRecord {
  id                   String           @id @default(uuid()) @db.Uuid
  researchObjectId     String           @map("research_object_id") @db.Uuid
  versionId            String           @map("version_id") @db.Uuid
  workspaceId          String           @map("workspace_id") @db.Uuid
  claimId              String           @map("claim_id") @db.Uuid
  artifactId           String           @map("artifact_id") @db.Uuid
  kind                 EvidenceKind
  title                String
  exactQuote           String?          @map("exact_quote") @db.Text
  relation             ClaimRelation
  locator              Json
  contentHash          String           @map("content_hash") @db.Char(64)
  extractionConfidence Float?           @map("extraction_confidence")
  extractionStatus     ExtractionStatus @default(needs_review) @map("extraction_status")
  verifiedByUserId     String?          @map("verified_by_user_id") @db.Uuid
  provenance           Json
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  researchObject ResearchObject @relation(fields: [researchObjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade, map: "evidence_records_research_object_workspace_fkey")
  version        Version        @relation(fields: [versionId, researchObjectId], references: [id, researchObjectId], onDelete: Cascade, map: "evidence_records_version_scope_fkey")
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claim          ClaimNode      @relation(fields: [claimId, researchObjectId, versionId], references: [id, researchObjectId, versionId], onDelete: Cascade, map: "evidence_records_claim_scope_fkey")
  artifact       Artifact       @relation(fields: [artifactId, workspaceId], references: [id, workspaceId], onDelete: Restrict, map: "evidence_records_artifact_workspace_fkey")
  verifiedBy     User?          @relation("EvidenceVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([researchObjectId, versionId, relation])
  @@index([claimId])
  @@index([artifactId, contentHash])
  @@index([verifiedByUserId])
  @@map("evidence_records")
}

model PresentationAsset {
  id               String                  @id @default(uuid()) @db.Uuid
  researchObjectId String                  @map("research_object_id") @db.Uuid
  versionId        String                  @map("version_id") @db.Uuid
  kind             PresentationAssetKind
  objectKey        String                  @map("object_key")
  contentHash      String                  @map("content_hash") @db.Char(64)
  generator        String
  generatorVersion String                  @map("generator_version")
  promptHash       String?                 @map("prompt_hash") @db.Char(64)
  status           PresentationAssetStatus @default(draft)
  label            String                  @default("presentation_not_evidence")
  provenance       Json
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  researchObject ResearchObject           @relation(fields: [researchObjectId], references: [id], onDelete: Cascade)
  version        Version                  @relation(fields: [versionId, researchObjectId], references: [id, researchObjectId], onDelete: Cascade, map: "presentation_assets_version_scope_fkey")
  sourceClaims   PresentationAssetClaim[]

  @@unique([id, researchObjectId, versionId], map: "presentation_assets_id_ro_version_key")
  @@index([researchObjectId, versionId, status])
  @@index([contentHash])
  @@map("presentation_assets")
}

model PresentationAssetClaim {
  presentationAssetId String @map("presentation_asset_id") @db.Uuid
  claimId             String @map("claim_id") @db.Uuid
  researchObjectId    String @map("research_object_id") @db.Uuid
  versionId           String @map("version_id") @db.Uuid

  presentationAsset PresentationAsset @relation(fields: [presentationAssetId, researchObjectId, versionId], references: [id, researchObjectId, versionId], onDelete: Cascade, map: "presentation_asset_claims_asset_scope_fkey")
  claim             ClaimNode         @relation(fields: [claimId, researchObjectId, versionId], references: [id, researchObjectId, versionId], onDelete: Restrict, map: "presentation_asset_claims_claim_scope_fkey")

  @@id([presentationAssetId, claimId])
  @@index([claimId])
  @@map("presentation_asset_claims")
}
