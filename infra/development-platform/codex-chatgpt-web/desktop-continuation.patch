@@ -0,0 +1,426 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { randomUUID } from "node:crypto";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { dirname, isAbsolute, join, relative, resolve } from "node:path";
+import { rememberCompactionContinuation } from "../src/adapters/chatgpt-web/compaction-continuation";
+import {
+  CHATGPT_TURN_REVISION_CONFLICT_MESSAGE,
+  chatGptTurnUserRevisionHistory,
+  extractChatGptTurnEnvironment,
+  extractChatGptTurnIdentity,
+  extractChatGptTurnUserRevision,
+  type ChatGptTurnEnvironment,
+} from "../src/adapters/chatgpt-web/environment";
+import { ChatGptThreadEnvironmentStore } from "../src/adapters/chatgpt-web/thread-environment";
+import { chatGptInstructionLineage, chatGptTurnExecutionKey, chatGptTurnRoundKey } from "../src/adapters/chatgpt-web/turn-execution";
+import { encodeCompactionSummary, SUMMARY_PREFIX } from "../src/responses/compaction";
+import { parseRequest } from "../src/responses/parser";
+import { defaultConfig } from "../src/config";
+import { responseRequest } from "../src/server";
+
+type WireItem = Record<string, unknown>;
+const fixtureParent = resolve(import.meta.dir, "..", "..");
+const ownedDirectories: string[] = [];
+
+afterEach(() => {
+  for (const directory of ownedDirectories.splice(0)) {
+    const withinParent = relative(fixtureParent, directory);
+    if (!withinParent || withinParent.startsWith("..") || isAbsolute(withinParent)) {
+      throw new Error("Refusing to remove a fixture outside its project tmp directory");
+    }
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+function fixture() {
+  const directory = mkdtempSync(join(fixtureParent, "desktop-continuation-fixture-"));
+  ownedDirectories.push(directory);
+  const cwd = join(directory, "workspace");
+  const codexHome = join(directory, "codex-home");
+  mkdirSync(cwd);
+  mkdirSync(codexHome);
+  const threadId = randomUUID();
+  const turnId = randomUUID();
+  const sourceThreadId = randomUUID();
+  const environment = `<environment_context>\n<cwd>${cwd}</cwd>\n<filesystem><workspace_roots><root>${cwd}</root></workspace_roots><permission_profile type="disabled"><file_system type="unrestricted" /></permission_profile></filesystem>\n</environment_context>`;
+  const metadata = {
+    request_kind: "turn", thread_id: threadId, turn_id: turnId,
+    agent_name: "/root", sandbox_mode: "danger-full-access", workspaces: { [cwd]: {} },
+  };
+  const tools = [{ type: "function", name: "read_fixture", description: "Read the fixture", parameters: { type: "object" } }];
+  const message = (id: string, role: "user" | "developer", text: string, owner = turnId): WireItem => ({
+    type: "message", id, role, content: [{ type: "input_text", text }],
+    internal_chat_message_metadata_passthrough: { turn_id: owner, content_item_kinds: [role === "user" ? "user.text" : "developer.text"] },
+  });
+  const preamble = (): WireItem => ({
+    type: "message", id: "msg_native_preamble", role: "user",
+    content: [
+      { type: "input_text", text: "<recommended_plugins>Example plugin</recommended_plugins>" },
+      { type: "input_text", text: "# AGENTS.md instructions\n<INSTRUCTIONS>Preserve existing changes.</INSTRUCTIONS>" },
+      { type: "input_text", text: environment },
+    ],
+    internal_chat_message_metadata_passthrough: {
+      turn_id: turnId,
+      content_item_kinds: ["plugins.recommendations", "agents_md.instructions", "environments.environment_context"],
+    },
+  });
+  const delegation = (name: string): WireItem => ({
+    type: "function_call_output", name, id: `fco_${name}`, call_id: `call_${name}`,
+    output: `<codex_delegation>\n<source_thread_id>${sourceThreadId}</source_thread_id>\n<input>Inspect the current workspace and report the bounded change.</input>\n</codex_delegation>`,
+    internal_chat_message_metadata_passthrough: { turn_id: turnId },
+  });
+  const request = (input: WireItem[], changes: {
+    model?: string; effort?: string; metadata?: Record<string, unknown>;
+  } = {}) => parseRequest({
+    model: changes.model ?? "chatgpt-web/high", stream: false,
+    reasoning: { effort: changes.effort ?? "high" }, tools, input,
+    client_metadata: { "x-codex-turn-metadata": JSON.stringify({ ...metadata, ...changes.metadata }) },
+  });
+  const store = () => new ChatGptThreadEnvironmentStore(undefined, Date.now, codexHome, codexHome);
+  const expectedEnvironment: ChatGptTurnEnvironment = {
+    cwd, roots: [cwd], writableRoots: [cwd], sandboxPolicy: { type: "dangerFullAccess" },
+    tools: [{ name: "read_fixture", description: "Read the fixture", parameters: { type: "object" } }],
+  };
+  const rolloutPath = join(codexHome, "sessions", "2026", "09", "20", `rollout-2026-09-20T10-00-00-${threadId}.jsonl`);
+  const writeRollout = (changes: Record<string, unknown> = {}) => {
+    mkdirSync(dirname(rolloutPath), { recursive: true });
+    writeFileSync(rolloutPath, [
+      { type: "session_meta", payload: { id: threadId, source: "vscode" } },
+      { type: "turn_context", payload: {
+        turn_id: turnId, cwd, workspace_roots: [cwd], approval_policy: "never",
+        sandbox_policy: { type: "danger-full-access" }, permission_profile: { type: "disabled" },
+        model: "chatgpt-web/high", summary: "auto", ...changes,
+      } },
+    ].map(value => JSON.stringify(value)).join("\n") + "\n");
+  };
+  const checkpoint = (summary: string): WireItem => ({
+    type: "compaction", encrypted_content: encodeCompactionSummary(summary),
+  });
+  const remember = (source: WireItem, summary: string) => {
+    const compact = request([source, { type: "compaction_trigger" }]);
+    rememberCompactionContinuation(compact, extractChatGptTurnIdentity(compact), [{
+      itemId: source.id as string,
+      turnId: (source.internal_chat_message_metadata_passthrough as { turn_id: string }).turn_id,
+      content: source.type === "function_call_output" ? source.output : source.content,
+    }], summary);
+  };
+  return { cwd, turnId, threadId, environment, message, preamble, delegation, request,
+    store, expectedEnvironment, rolloutPath, writeRollout, checkpoint, remember };
+}
+
+describe("native Desktop delegation supplies the instruction and Full environment", () => {
+  for (const name of ["create_thread", "send_message_to_thread"]) {
+    test(`${name} after only a grouped native preamble is the current revision`, () => {
+      const f = fixture();
+      const task = f.delegation(name);
+      const parsed = f.request([f.preamble(), task]);
+      expect(extractChatGptTurnUserRevision(parsed)).toEqual(task.output);
+      expect(extractChatGptTurnEnvironment(parsed)).toEqual(f.expectedEnvironment);
+      expect(f.store().resolve(parsed)).toEqual(f.expectedEnvironment);
+      expect((parsed._rawBody as { input: WireItem[] }).input[1]).toEqual(task);
+      expect(parsed.context.messages.at(-1)?.role).toBe("toolResult");
+    });
+  }
