[Unit]
Description=OpenScience fixed native Hermes launcher
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 @ADAPTER_RELEASE@/host_broker.py
User=root
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
# Socket hardlinks must remain on one mount. Protect immutable children separately.
ReadWritePaths=/opt/openscience-hermes
ReadOnlyPaths=-/opt/openscience-hermes/releases -/opt/openscience-hermes/runtime.env -/opt/openscience-hermes/install.lock -/opt/openscience-hermes/observations
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
StandardOutput=null
StandardError=null
