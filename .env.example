# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# --- MiniMax AI Gateway (runtime secrets stay in local/server env only) ---
AI_ENABLED=false
MINIMAX_API_MODE=auto
MINIMAX_API_KEY=
MINIMAX_API_KEY_2=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TOKEN_PLAN_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_BASE_URL=https://api.minimax.io/v1
AI_DISABLED_PROVIDERS=

# MiniMax Coding Plan VLM: default disabled; enable only after credential rotation,
# trusted external-processing policy wiring and a paid minimal-page canary.
MINIMAX_VISION_ENABLED=false
MINIMAX_VISION_REGION=global
MINIMAX_VISION_MODEL=coding-plan-vlm
MINIMAX_VISION_USD_MICROS_PER_PAGE=
MINIMAX_VISION_PRICING_VERSION=
MINIMAX_VISION_PRICING_EFFECTIVE_DATE=
MINIMAX_VISION_SERVICE_TIER=
MINIMAX_VISION_MAX_PAGE_BYTES=4194304
LLM_OCR_MAX_PAGES=4
LLM_OCR_MAX_PAGE_BYTES=4194304
LLM_OCR_MAX_TOTAL_BYTES=8388608

# --- P1A-2 dev stack (local development defaults only, NOT real secrets) ---
POSTGRES_USER=openscience
POSTGRES_PASSWORD=openscience_dev
POSTGRES_DB=openscience
POSTGRES_PORT=5432
DATABASE_URL=postgresql://openscience:openscience_dev@127.0.0.1:5432/openscience
SEARCH_DATABASE_URL=postgresql://openscience:openscience_dev@127.0.0.1:5432/openscience_search
SEARCH_POSTGRES_DB=openscience_search
BGE_M3_ENABLED=false
BGE_M3_DEPLOY=false
BGE_M3_MODEL_VERSION_ID=ea457d84-2cbb-5939-8b2a-8c2969e9eec8
BGE_M3_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
BGE_M3_SOURCE_SHA256=
BGE_M3_PACKAGE_FREEZE_SHA256=
BGE_M3_MODEL_MANIFEST_SHA256=
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_ENABLED=true
TAVILY_API_KEY=
RETRIEVAL_QUERY_HMAC_SECRET=
SCANSCI_ENABLED=false
SCANSCI_BASE_URL=http://scansci-legal:8080
SCANSCI_SERVICE_TOKEN=
TEMP_DOCUMENT_SIGNING_SECRET=
TEMP_DOCUMENT_SIGNING_KEY_ID=download-v1
EMBEDDING_WORKER_URL=http://embedding-worker:8080
REDIS_URL=redis://127.0.0.1:6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=openscience_minio_dev
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_DRIVER=minio
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=openscience_minio_dev
S3_BUCKET=openscience-dev

# --- P1A-3 auth (dev defaults only, NOT real secrets) ---
PORT=3001
COOKIE_SECRET=openscience-dev-cookie-secret
SECURE_COOKIES=false
NODE_ENV=development
