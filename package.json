{
  "name": "openscience",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && node scripts/verify-workspace.mjs && pnpm audit:docs-sync",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "audit:knip": "knip",
    "audit:dep": "depcruise packages apps --config .dependency-cruiser.cjs",
    "audit:dup": "jscpd packages apps --min-tokens 50 --reporters console",
    "audit:deps": "syncpack lint",
    "audit:docs-sync": "node --test scripts/docs/docs-sync-skill.test.mjs && node scripts/docs/check-docs-sync.mjs",
    "audit:hermes-capabilities": "node --test scripts/research-intelligence/verify-capability-registry.test.mjs && node scripts/research-intelligence/verify-capability-registry.mjs",
    "docs:lint": "markdownlint-cli2 \"docs/**/*.md\" \"AGENTS.md\" \"project_index.md\"",
    "stack:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d || docker-compose -f infra/compose/docker-compose.dev.yml up -d",
    "stack:down": "docker compose -f infra/compose/docker-compose.dev.yml down || docker-compose -f infra/compose/docker-compose.dev.yml down",
    "stack:ps": "docker compose -f infra/compose/docker-compose.dev.yml ps || docker-compose -f infra/compose/docker-compose.dev.yml ps",
    "stack:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f || docker-compose -f infra/compose/docker-compose.dev.yml logs -f",
    "test": "pnpm run test:release-contract && pnpm -r --workspace-concurrency=1 --if-present test",
    "test:release-contract": "node --test scripts/release-input-manifest.test.mjs scripts/hermes-full-release-gate.test.mjs scripts/register-search-model.test.mjs infra/scripts/accept-document-parser-release.test.mjs infra/scripts/verify-document-parser-acceptance.test.mjs infra/scripts/atomic-squid-config.test.mjs infra/scripts/deploy.test.mjs infra/scripts/import-scansci-cookies.test.mjs infra/scripts/production-release-retention.test.mjs",
    "test:research-intelligence": "pnpm --filter @openscience/agent-worker test:research-intelligence",
    "test:integration": "pnpm stack:up && pnpm -r --if-present test:integration",
    "invite": "node scripts/invite.mjs",
    "seed:demo-research": "node scripts/seed-demo-research.mjs",
    "sync:ror": "pnpm --filter @openscience/database build && pnpm --filter @openscience/database sync:ror --",
    "api": "pnpm --filter @openscience/api start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@openscience/auth": "workspace:*",
    "@openscience/domain": "workspace:*",
    "@prisma/client": "5.22.0",
    "@types/node": "20.14.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "9.39.5",
    "jscpd": "^5.0.14",
    "knip": "^6.29.0",
    "markdownlint-cli2": "^0.23.2",
    "prisma": "5.22.0",
    "syncpack": "^15.3.2",
    "task-master-ai": "^0.43.1",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20"
  }
}
