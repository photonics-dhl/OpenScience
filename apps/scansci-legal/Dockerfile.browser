FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17 AS python-dependencies

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /requirements
RUN python -m venv /opt/scansci-venv
COPY build-requirements.lock requirements.lock browser-requirements.lock ./
RUN /opt/scansci-venv/bin/python -m pip install --require-hashes -r build-requirements.lock \
    && /opt/scansci-venv/bin/python -m pip install --require-hashes --no-build-isolation -r requirements.lock \
    && /opt/scansci-venv/bin/python -m pip install --require-hashes -r browser-requirements.lock

FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ENV PATH=/opt/scansci-venv/bin:$PATH \
    PYTHONPATH=/opt/scansci/src \
    PYTHONNOUSERSITE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp/scansci-browser-home \
    DISPLAY=:99

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-noto-cjk tini xvfb \
    && dpkg-query -W -f='${Package}=${Version}\n' ca-certificates chromium fonts-noto-cjk tini xvfb \
      | sort > /opt/scansci-browser-packages.txt \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 11000 scansci-browser \
    && useradd --uid 10002 --gid 11000 --home-dir /tmp/scansci-browser-home --no-create-home --shell /usr/sbin/nologin scansci-browser \
    && install -d -o 10002 -g 11000 -m 0750 /browser-inputs /browser-outputs \
    && install -d -o 10002 -g 11000 -m 0700 /browser-profile-jobs /tmp/scansci-browser /tmp/scansci-browser-home \
    && install -d -m 0755 /opt/google/chrome \
    && ln -s /usr/local/bin/scansci-chromium /opt/google/chrome/chrome
COPY --from=python-dependencies /opt/scansci-venv /opt/scansci-venv
COPY src /opt/scansci/src
COPY --chmod=0555 chromium-container-wrapper.sh /usr/local/bin/scansci-chromium
COPY --chmod=0555 browser-entrypoint.sh /usr/local/bin/scansci-browser-entrypoint

ARG XGS_RELEASE_IMAGE_TAG
ARG SCANSCI_ARCHIVE_SHA256
ARG SCANSCI_REQUIREMENTS_SHA256
ARG SCANSCI_BUILD_REQUIREMENTS_SHA256
ARG SCANSCI_BROWSER_REQUIREMENTS_SHA256
LABEL org.openscience.source=$XGS_RELEASE_IMAGE_TAG \
    org.openscience.scansci.role=browser \
    org.openscience.scansci.archive-sha256=$SCANSCI_ARCHIVE_SHA256 \
    org.openscience.scansci.requirements-sha256=$SCANSCI_REQUIREMENTS_SHA256 \
    org.openscience.scansci.build-requirements-sha256=$SCANSCI_BUILD_REQUIREMENTS_SHA256 \
    org.openscience.scansci.browser-requirements-sha256=$SCANSCI_BROWSER_REQUIREMENTS_SHA256

USER 10002:11000
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/scansci-browser-entrypoint"]
