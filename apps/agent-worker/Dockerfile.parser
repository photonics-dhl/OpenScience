FROM node:22-bookworm

ARG XGS_RELEASE_IMAGE_TAG
LABEL org.openscience.source=$XGS_RELEASE_IMAGE_TAG

RUN apt-get update \
  && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/agent-worker/parser-image/package.json apps/agent-worker/parser-image/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && mkdir -p /parser-jobs \
  && chown node:node /parser-jobs

COPY --chown=node:node apps/agent-worker/dist/ingestion-parser.js ./dist/ingestion-parser.js
COPY --chown=node:node apps/agent-worker/dist/parsers/job-protocol.js ./dist/parsers/job-protocol.js
COPY --chown=node:node apps/agent-worker/dist/parsers/page-quality.js ./dist/parsers/page-quality.js
COPY --chown=node:node apps/agent-worker/dist/parsers/ocr-parser.js ./dist/parsers/ocr-parser.js
COPY --chown=node:node apps/agent-worker/dist/parsers/native-pdf-contract.js ./dist/parsers/native-pdf-contract.js
COPY --chown=node:node apps/agent-worker/dist/parsers/native-pdf-text-items.js ./dist/parsers/native-pdf-text-items.js
COPY --chown=node:node apps/agent-worker/dist/parser-job-isolation.js ./dist/parser-job-isolation.js
COPY --chown=node:node apps/agent-worker/dist/parser-service.js ./dist/parser-service.js
COPY --chown=node:node packages/domain/package.json ./node_modules/@openscience/domain/package.json
COPY --chown=node:node packages/domain/dist/research-intelligence/virtual-page.js ./node_modules/@openscience/domain/dist/research-intelligence/virtual-page.js

USER node
CMD ["node", "dist/parser-service.js"]
