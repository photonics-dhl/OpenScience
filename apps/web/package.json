{
  "name": "@openscience/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test test/hermes-cubism-export-contract.test.mjs test/hermes-live2d-source-art.test.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:signup": "playwright test --config playwright.signup.config.ts",
    "test:release": "playwright test product-release.spec.ts academic-identity-recovery.spec.ts --config playwright.release.config.ts",
    "test:claim-first-release": "node test/visual/claim-first-public-ro-gate.mjs",
    "test:hermes-release": "node test/visual/hermes-release-gate.mjs",
    "test:hermes-companion-release": "node test/visual/hermes-release-gate.mjs",
    "test:hermes-blank-ro-production": "node test/visual/hermes-blank-ro-production-gate.mjs",
    "test:hermes-live2d": "node test/visual/hermes-live2d-motion-gate.mjs",
    "test:hermes-work-assistant": "node test/visual/hermes-work-assistant-experience-gate.mjs",
    "shots": "node test/visual/shots.mjs",
    "shots:workspace": "node test/visual/workspace-shots.mjs",
    "shots:readability": "node test/visual/workspace-readability-gate.mjs",
    "shots:public": "node test/visual/public-reading-shots.mjs",
    "shots:optical-lab": "node test/visual/optical-lab-gate.mjs",
    "shots:hermes": "node test/visual/hermes-articulation-gate.mjs",
    "atlas:optical": "node scripts/generate-optical-atlas.mjs"
  },
  "dependencies": {
    "@openscience/domain": "workspace:^",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next": "14.2.35",
    "next-intl": "^4.13.4",
    "ogl": "1.0.11",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "7.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "msdf-bmfont-xml": "2.8.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "vitest": "^2"
  }
