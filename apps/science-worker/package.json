{
  "name": "@openscience/science-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ sandbox-security sandbox-escape",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js \"--testPathPattern=sandbox-(security|escape)\""
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@openscience/database": "workspace:^",
    "@openscience/domain": "workspace:^",
    "dockerode": "^5.0.1"
  }
}
