{
  // 基线原则：保留结构性规则（重复标题/列表乱序/围栏语言/表格列数等），
  // 仅豁免排版风格类规则——每条豁免附一行理由
  "config": {
    "default": true,
    "MD013": false, // 行长：中文长句与宽表格（进度日志/需求基线）不限制
    "MD060": false, // 表格管道对齐：紧凑写法（| 不补空格对齐）为本库表格惯例
    "MD058": false, // 表格前后空行：表格常紧跟加粗引导行的高密度排版
    "MD022": false, // 标题前后空行：同上，中文文档标题紧邻引导行
    "MD032": false, // 列表前后空行：同上，列表常紧跟加粗引导行
    "MD034": false, // 裸 URL：进度日志/索引/参考资料中的裸链接是有意引用
    "MD024": { "siblings_only": true }, // 允许不同日期章节下同名小节（如多个「### ✅ Completed」），仍禁止同节重复标题
    "MD029": false // 审计文档跨小节连续编号（7. 接 1.-6.）为有意风格，markdownlint 不支持非 1 起始的升序列表
  },
  "ignores": ["**/node_modules/**", "**/.worktrees/**", "docs/user_ideas/8.10/**"]
}
