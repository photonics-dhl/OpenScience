{
  "name": "@openscience/database",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate --schema ../../infra/schema.prisma",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrate-cli.js",
    "sync:ror": "node dist/ror-sync-cli.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@openscience/config": "workspace:^",
    "@openscience/observability": "workspace:^",
    "@prisma/client": "5.22.0",
    "ioredis": "5"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "prisma": "5.22.0",
    "vitest": "^2"
  }
}
