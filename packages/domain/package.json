{
  "name": "@openscience/domain",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./virtual-page": {
      "types": "./dist/research-intelligence/virtual-page.d.ts",
      "default": "./dist/research-intelligence/virtual-page.js"
    },
    "./test-helpers": { "types": "./test/helpers/fakes.ts", "default": "./test/helpers/fakes.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openscience/auth": "workspace:^",
    "@openscience/diff": "workspace:^",
    "@openscience/identity": "workspace:^",
    "@openscience/observability": "workspace:^",
    "@openscience/sdf-schema": "workspace:^",
    "@openscience/storage": "workspace:^",
    "@openscience/versioning": "workspace:^",
    "@prisma/client": "5.22.0",
    "file-type": "^22.0.1",
    "ioredis": "5"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "vitest": "^2"
  }
}
